[Unit]
Description=Ayla Giveaway Hunter Collector
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/ayla_giveaway_hunter
EnvironmentFile=/home/pi/ayla_giveaway_hunter/.env
ExecStart=/home/pi/ayla_giveaway_hunter/.venv/bin/python -m app.collector
Restart=always
RestartSec=20
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
